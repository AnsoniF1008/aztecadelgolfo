# Copy to .env and fill in from the Firebase console
# (Project settings > Your apps > SDK setup and configuration).
# These identify the project; they are not secrets. The rules are what protect data.
#
# Do NOT put VITE_USE_EMULATORS here. It lives in .env.development (true) and
# .env.production (false), both committed, so `npm run dev` can never write to
# the real database and `npm run build` always targets it.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=aztecadelgolfofishingclu-bc814.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aztecadelgolfofishingclu-bc814
VITE_FIREBASE_STORAGE_BUCKET=aztecadelgolfofishingclu-bc814.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=713022433519
VITE_FIREBASE_APP_ID=
