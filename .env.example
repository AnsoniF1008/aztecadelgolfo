# Copy to .env — with the emulators, demo values are fine
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=azteca-del-golfo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=azteca-del-golfo
VITE_FIREBASE_STORAGE_BUCKET=azteca-del-golfo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
# true = connect to the local emulators
VITE_USE_EMULATORS=true
