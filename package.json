{
  "name": "azteca-del-golfo-fishing-club",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --import=./emulator-data --export-on-exit",
    "emulators:fresh": "firebase emulators:start --export-on-exit=./emulator-data",
    "seed": "node scripts/seed.js",
    "icons": "node scripts/icons.js",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore,storage",
    "deploy:functions": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase": "^10.14.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "firebase-admin": "^12.6.0",
    "sharp": "^0.35.4",
    "vite": "^5.4.8"
  }
}
